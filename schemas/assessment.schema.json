{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "assessment.schema.json",
  "title": "Software architecture quality assessment",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "mode",
    "depth",
    "score_requested",
    "context_profiles",
    "custom_domain_weights",
    "evidence",
    "factors",
    "gates"
  ],
  "properties": {
    "schema_version": { "const": "2.0" },
    "mode": {
      "enum": ["DESIGN", "REVIEW", "CHANGE", "MODERNIZATION", "INCIDENT"]
    },
    "depth": { "enum": ["TRIAGE", "STANDARD", "DEEP"] },
    "score_requested": { "type": "boolean" },
    "context_profiles": {
      "type": "array",
      "items": {
        "enum": [
          "security-critical-regulated",
          "high-scale-distributed",
          "fast-changing-product",
          "legacy-modernization",
          "public-platform-api",
          "data-intensive",
          "ai-system"
        ]
      },
      "uniqueItems": true
    },
    "custom_domain_weights": {
      "oneOf": [
        { "type": "null" },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["A", "B", "C", "D", "E", "F", "G", "H"],
          "properties": {
            "A": { "type": "number", "minimum": 0 },
            "B": { "type": "number", "minimum": 0 },
            "C": { "type": "number", "minimum": 0 },
            "D": { "type": "number", "minimum": 0 },
            "E": { "type": "number", "minimum": 0 },
            "F": { "type": "number", "minimum": 0 },
            "G": { "type": "number", "minimum": 0 },
            "H": { "type": "number", "minimum": 0 }
          }
        }
      ]
    },
    "evidence": {
      "type": "array",
      "items": { "$ref": "evidence.schema.json" }
    },
    "factors": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "applicability",
          "health",
          "confidence",
          "evidence_ids"
        ],
        "properties": {
          "id": { "type": "string", "pattern": "^AQ-[A-H][0-9]{2}$" },
          "applicability": {
            "enum": ["ASSESSED", "UNKNOWN", "NOT_APPLICABLE"]
          },
          "health": { "type": ["integer", "null"], "minimum": 0, "maximum": 4 },
          "confidence": { "enum": ["LOW", "MEDIUM", "HIGH", "UNKNOWN"] },
          "evidence_ids": {
            "type": "array",
            "items": { "type": "string", "pattern": "^EV-[A-Z0-9-]+$" },
            "uniqueItems": true
          }
        },
        "allOf": [
          {
            "if": {
              "properties": { "applicability": { "const": "ASSESSED" } },
              "required": ["applicability"]
            },
            "then": {
              "properties": {
                "health": { "type": "integer", "minimum": 0, "maximum": 4 },
                "confidence": { "enum": ["LOW", "MEDIUM", "HIGH"] },
                "evidence_ids": { "minItems": 1 }
              }
            },
            "else": { "properties": { "health": { "type": "null" } } }
          }
        ]
      }
    },
    "gates": {
      "type": "object",
      "additionalProperties": false,
      "required": ["security", "data_integrity", "recovery", "safety_compliance"],
      "properties": {
        "security": { "$ref": "#/$defs/gate" },
        "data_integrity": { "$ref": "#/$defs/gate" },
        "recovery": { "$ref": "#/$defs/gate" },
        "safety_compliance": { "$ref": "#/$defs/gate" }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": { "score_requested": { "const": true } },
        "required": ["score_requested"]
      },
      "then": { "properties": { "depth": { "const": "DEEP" } } }
    }
  ],
  "$defs": {
    "gate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "evidence_ids"],
      "properties": {
        "status": { "enum": ["PASS", "FAIL", "UNKNOWN", "NOT_APPLICABLE"] },
        "evidence_ids": {
          "type": "array",
          "items": { "type": "string", "pattern": "^EV-[A-Z0-9-]+$" },
          "uniqueItems": true
        }
      },
      "allOf": [
        {
          "if": {
            "properties": { "status": { "enum": ["PASS", "FAIL"] } },
            "required": ["status"]
          },
          "then": { "properties": { "evidence_ids": { "minItems": 1 } } }
        }
      ]
    }
  }
}
